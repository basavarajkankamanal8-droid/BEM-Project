rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.role == 'super_admin';
    }

    // Public imagery folder
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Citizen incident photographs (PRD §18, §59 & §83)
    match /citizen_photos/{userId}/{fileName} {
      // Citizen uploads must not exceed 5MB and must be image types
      allow create: if isAuthenticated() && 
                       request.auth.uid == userId && 
                       request.resource.size < 5 * 1024 * 1024 &&
                       request.resource.contentType.matches('image/.*');
      allow read: if isAuthenticated() || isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // Confidential operational evidence & raw satellite imagery
    match /observations/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Security & audit dumps
    match /security_evidence/{allPaths=**} {
      allow read, write: if isSuperAdmin();
    }
  }
}
